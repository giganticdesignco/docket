# Supabase project settings > API. The publishable key is used by the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
# Secret key: server only, read by server/api routes that need the Admin API
# (creating accounts). Never shipped to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Harvest personal access token (id.getharvest.com/developers). Server only, used by /api/harvest/import.
NUXT_HARVEST_ACCESS_TOKEN=
NUXT_HARVEST_ACCOUNT_ID=

# ClickUp personal API token (ClickUp > Settings > Apps) and the workspace id.
NUXT_CLICKUP_TOKEN=pk_...
NUXT_CLICKUP_TEAM_ID=8666791

# Vercel only: it sends CRON_SECRET as a bearer token with cron requests;
# the app reads the same value through NUXT_CRON_SECRET. Set both.
CRON_SECRET=
NUXT_CRON_SECRET=
